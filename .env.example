# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase Configuration (Firestore, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Optional: GitHub OAuth (if using GitHub login)
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id

# Optional: Google OAuth (if using Google login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Server-side only (NOT exposed to client)
GITHUB_CLIENT_SECRET=your_github_oauth_secret
GITHUB_TOKEN=your_github_pat

# Sandbox execution (Go / Rust / PHP via glot.io)
# Free token: sign up at https://glot.io, grab token at https://glot.io/account/token
GLOT_API_TOKEN=your_glot_api_token

# Groq AI (Easter Egg Chat)
GROQ_API_KEY=your_groq_api_key

# Development
NEXT_PUBLIC_APP_URL=http://localhost:3000
